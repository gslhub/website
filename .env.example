# GSLHub application
NEXT_PUBLIC_SITE_URL=https://gslhub.com

# Payload CMS — set these in Hostinger before CMS activation
PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/gslhub

