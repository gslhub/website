# GSLHub application
NEXT_PUBLIC_SITE_URL=https://gslhub.com

# Payload CMS
# Generate a long, unique secret for each environment.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# MongoDB Atlas
# Replace the placeholders with the database user, URL-encoded password and cluster hostname.
# The application selects the `gslhub` database in payload.config.ts.
DATABASE_URL=mongodb+srv://<username>:<url-encoded-password>@<cluster-hostname>/?retryWrites=true&w=majority&appName=GSLHub

# Research artifact storage
# Production must use an ABSOLUTE local directory outside the Node.js deployment directory.
# Hostinger example:
# /home/<username>/domains/gslhub.com/gslhub-data/research-artifacts
RESEARCH_ARTIFACT_LOCAL_DIR=

# Operational verification markers
# Set these only after the corresponding checks have actually passed.
# The *_PATH value must match RESEARCH_ARTIFACT_LOCAL_DIR exactly.
PILOT_ARTIFACT_ROUNDTRIP_VERIFIED_AT=
PILOT_ARTIFACT_ROUNDTRIP_VERIFIED_PATH=
PILOT_BACKUP_RECOVERY_VERIFIED_AT=
PILOT_BACKUP_RECOVERY_VERIFIED_PATH=
