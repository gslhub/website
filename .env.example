# GSLHub application
NEXT_PUBLIC_SITE_URL=https://gslhub.com

# Payload CMS
# Generate a long, unique secret for each environment.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# MongoDB Atlas
# Replace the placeholders with the database user, URL-encoded password and cluster hostname.
# The application selects the `gslhub` database in payload.config.ts.
DATABASE_URL=mongodb+srv://<username>:<url-encoded-password>@<cluster-hostname>/?retryWrites=true&w=majority&appName=GSLHub

# Durable research-artifact storage
# Keep S3_ENABLED=false until the bucket, access policy and recovery procedure are ready.
# The adapter also supports S3-compatible services by setting S3_ENDPOINT and S3_FORCE_PATH_STYLE.
S3_ENABLED=false
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=research-artifacts

# Pilot storage verification attestations
# Set these only after completing the documented checks. Use ISO-8601 UTC timestamps.
# Example: 2026-07-30T10:30:00Z
PILOT_ARTIFACT_ROUNDTRIP_VERIFIED_AT=
PILOT_BACKUP_RECOVERY_VERIFIED_AT=
